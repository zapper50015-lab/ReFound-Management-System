@model IEnumerable<ReFound.Models.FoundItem>

@{
    ViewData["Title"] = "Index";
}

<h1>Found Items</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<!-- Live AI Search Input Box -->
<div class="mb-3">
    <input type="text" id="foundSearchBox" class="form-control"
           placeholder="Live AI search (e.g., 'black hydroflask near gym', 'apple laptop charger')..." />
</div>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ItemName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Category)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DateFound)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LocationFound)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody id="foundItemRows">
@foreach (var item in Model) {
        <tr class="searchable-row" data-item-id="@item.Id">
            <td>
                @Html.DisplayFor(modelItem => item.ItemName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Category)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DateFound)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LocationFound)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

@section Scripts {
<script>
    let searchTimeout;
    const searchInput = document.getElementById("foundSearchBox");
    const rows = document.querySelectorAll("#foundItemRows tr");

    searchInput.addEventListener("input", function () {
        clearTimeout(searchTimeout);
        const query = this.value.trim();

        if (!query) {
            rows.forEach(row => row.style.display = "");
            return;
        }

        searchTimeout = setTimeout(async () => {
            try {
                console.log("1. Sending query:", query);
                const res = await fetch(`/FoundItems/SmartSearch?query=${encodeURIComponent(query)}`);
                console.log("2. Response status:", res.status);

                if (!res.ok) {
                    const errText = await res.text();
                    console.error("Server error:", errText);
                    return;
                }

                const matchingIds = await res.json();
                console.log("3. Matching IDs:", matchingIds);

                rows.forEach(row => {
                    const id = parseInt(row.getAttribute("data-item-id"));
                    row.style.display = matchingIds.includes(id) ? "" : "none";
                });
            } catch (err) {
                console.error("Smart search failed:", err);
            }
        }, 500);
    });
</script>
}